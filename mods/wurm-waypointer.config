# Phase 0 diagnostic beam is disabled for normal play.
# Enable it only while manually verifying the pinned Wurm client build.
phase0BeamProbe=false
phase0BeamRed=0.20
phase0BeamGreen=0.75
phase0BeamBlue=1.00
phase0BeamAlpha=0.70
phase0BeamWidth=2.00
phase0BeamHeight=400.00
phase0BeamThroughWalls=false
phase0BeamThroughWallWidth=0.15
phase0BeamName=Waypoint 1

# Phase 1 static local core. Paths are relative to WurmLauncher unless absolute.
waypointDataFile=mods/wurm-waypointer/waypoints.wpt
waypointTransferFile=mods/wurm-waypointer/waypoints-transfer.wpt
# Independent per-server On/Off choices for the three managed vanilla landmarks.
vanillaLandmarkStateFile=mods/wurm-waypointer/vanilla-landmarks.state
# Sklotopolis Novus/Liberty currently use 4096 x 4096 tile maps.
waypointMapWidth=4096
waypointMapHeight=4096

# TreasureHunting Loot Map assistant. Every hunt gets one privacy-preserving
# JSON Lines file that can be shared for later planner calibration/training.
lootMapEnabled=true
lootMapLogDirectory=mods/wurm-waypointer/lootmap-hunts

# Completed archaeology report tracker. Active report sessions and confirmed
# hidden-cache tiles are persisted independently. Confirmed locations are
# server-scoped and are reused immediately for later reports from the same deed.
archaeologyEnabled=true
archaeologySessionFile=mods/wurm-waypointer/archaeology-sessions.properties
archaeologyKnownLocationsFile=mods/wurm-waypointer/archaeology-known-locations.properties
# Maximum number of completed or dismissed report sessions retained for audit.
archaeologyHistoryLimit=64

# On-ground route diagnostics are opt-in because full route geometry can be
# large. Enable them only while reproducing a planner fault for sharing.
navigationRouteDiagnostics=true
navigationRouteLogDirectory=mods/wurm-waypointer/navigation-routes
# Conservative cart profile. Exact loaded corners use the configured slope;
# centre/interpolated observations use half of it. Wurm Unlimited defines
# -0.7m maxDepth for small carts, large carts, and wagons.
navigationCartMaximumSlopeDirt=40.0
navigationCartMaximumWaterDepthMetres=0.7
# When diagnostics are enabled, harmless changes within this many leading route
# tiles are ignored if the remaining optimal route is unchanged.
navigationRouteLogTileInterval=8
# Route presentation: SOLID, MOVING_DASHES, or PULSE. PULSE launches every two
# seconds, crosses the captured route in one second, and leaves a 0.5s trace.
navigationRouteVisualStyle=PULSE
navigationPulseMaximumDistanceMetres=240

# Published Sklotopolis Highways are downloaded after login and cached outside
# the mod archive. The cache survives upgrades; refreshes run in background.
navigationHighwaysEnabled=true
navigationHighwaysCacheDirectory=mods/wurm-waypointer/maps
navigationHighwaysSyncMinutes=15

# Server-owned map shown in Wurm's native M window for recognised Sklotopolis
# worlds. Surface/deed downloads are asynchronous and cached across upgrades.
serverMapEnabled=true
serverMapCacheDirectory=mods/wurm-waypointer/maps
serverMapSyncMinutes=60
serverMapShowDeeds=true
serverMapShowHighways=true

# Phase 2 static navigation budgets. User markers remain endpoint/user filtered.
# Enabled managed vanilla landmarks are not removed by these user-effect limits.
phase2MaxCompassMarkers=64
phase2MaxWorldEffects=16
phase2WorldEffectDistanceMetres=12000
phase2MaxWorldLabels=16
phase2WorldLabelDistanceMetres=12000
